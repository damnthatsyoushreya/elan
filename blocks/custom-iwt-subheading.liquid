{% schema %}
{
  "name": "Custom Subheading",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "FALL / WINTER 24"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text color",
      "default": "#8F4A4E"
    }
  ],
  "presets": [
    {
      "name": "Custom Subheading"
    }
  ]
}
{% endschema %}

<div class="c-iwt__subheading" style="color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
  {{ block.settings.text }}
</div>
