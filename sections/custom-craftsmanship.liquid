{% schema %}
{
  "name": "Craftsmanship Story",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FAF5F0"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_4",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image 5"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_5",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image 6"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_6",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 120
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Craftsmanship Story"
    }
  ]
}
{% endschema %}

{% liquid
  assign image_count = 0
  if section.settings.image_1 != blank
    assign image_count = image_count | plus: 1
  endif
  if section.settings.image_2 != blank
    assign image_count = image_count | plus: 1
  endif
  if section.settings.image_3 != blank
    assign image_count = image_count | plus: 1
  endif
  if section.settings.image_4 != blank
    assign image_count = image_count | plus: 1
  endif
  if section.settings.image_5 != blank
    assign image_count = image_count | plus: 1
  endif
  if section.settings.image_6 != blank
    assign image_count = image_count | plus: 1
  endif
%}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .c-craft {
    display: flex;
    flex-direction: {% if section.settings.media_position == 'left' %}row-reverse{% else %}row{% endif %};
    justify-content: space-between;
    align-items: center;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 64px;
    padding-right: 64px;
    max-width: 1440px;
    margin: 0 auto;
    gap: 64px;
    box-sizing: border-box;
  }
  
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .c-craft {
      flex-direction: column;
      padding-left: 24px;
      padding-right: 24px;
      padding-top: calc({{ section.settings.padding_top }}px / 2);
      padding-bottom: calc({{ section.settings.padding_bottom }}px / 2);
      gap: 32px;
    }
  }

  #shopify-section-{{ section.id }} .c-craft__content {
    flex: 0 0 564px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
  }
  
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .c-craft__content {
      flex: none;
      width: 100%;
    }
  }

  #shopify-section-{{ section.id }} .c-craft__gallery {
    flex: 1 1 auto;
    display: grid;
    gap: 24px;
    width: 100%;
    align-items: stretch;
  }

  /* Grid Logic based on image count */
  {% if image_count == 1 %}
    #shopify-section-{{ section.id }} .c-craft__gallery {
      grid-template-columns: 1fr;
    }
  {% elsif image_count == 2 %}
    #shopify-section-{{ section.id }} .c-craft__gallery {
      grid-template-columns: 1fr 1fr;
    }
  {% elsif image_count == 3 %}
    #shopify-section-{{ section.id }} .c-craft__gallery {
      grid-template-columns: 1fr 1fr;
    }
    #shopify-section-{{ section.id }} .c-craft__image-wrap:first-child {
      grid-column: 1 / -1;
      aspect-ratio: 466 / 262;
    }
    #shopify-section-{{ section.id }} .c-craft__image-wrap:not(:first-child) {
      aspect-ratio: 1 / 1;
    }
  {% elsif image_count == 4 %}
    #shopify-section-{{ section.id }} .c-craft__gallery {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
    }
    #shopify-section-{{ section.id }} .c-craft__image-wrap {
      aspect-ratio: 1 / 1;
    }
  {% elsif image_count > 4 %}
    #shopify-section-{{ section.id }} .c-craft__gallery {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      grid-auto-flow: dense;
    }
    #shopify-section-{{ section.id }} .c-craft__image-wrap {
      aspect-ratio: 1 / 1;
    }
    #shopify-section-{{ section.id }} .c-craft__image-wrap:nth-child(3n) {
      grid-column: span 2;
      grid-row: span 2;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .c-craft__image-wrap {
    background: #FBEBE2;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    position: relative;
  }
  
  #shopify-section-{{ section.id }} .c-craft__image-wrap img,
  #shopify-section-{{ section.id }} .c-craft__image-wrap svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }
</style>

<div class="c-craft">
  <div class="c-craft__content">
    {% content_for 'blocks' %}
  </div>

  {% if image_count > 0 %}
    <div class="c-craft__gallery">
      {% if section.settings.image_1 != blank %}
        {% if section.settings.link_1 != blank %}<a href="{{ section.settings.link_1 }}" class="c-craft__image-wrap">{% else %}<div class="c-craft__image-wrap">{% endif %}
          {{ section.settings.image_1 | image_url: width: 800 | image_tag: loading: 'lazy' }}
        {% if section.settings.link_1 != blank %}</a>{% else %}</div>{% endif %}
      {% endif %}
      
      {% if section.settings.image_2 != blank %}
        {% if section.settings.link_2 != blank %}<a href="{{ section.settings.link_2 }}" class="c-craft__image-wrap">{% else %}<div class="c-craft__image-wrap">{% endif %}
          {{ section.settings.image_2 | image_url: width: 800 | image_tag: loading: 'lazy' }}
        {% if section.settings.link_2 != blank %}</a>{% else %}</div>{% endif %}
      {% endif %}
      
      {% if section.settings.image_3 != blank %}
        {% if section.settings.link_3 != blank %}<a href="{{ section.settings.link_3 }}" class="c-craft__image-wrap">{% else %}<div class="c-craft__image-wrap">{% endif %}
          {{ section.settings.image_3 | image_url: width: 800 | image_tag: loading: 'lazy' }}
        {% if section.settings.link_3 != blank %}</a>{% else %}</div>{% endif %}
      {% endif %}
      
      {% if section.settings.image_4 != blank %}
        {% if section.settings.link_4 != blank %}<a href="{{ section.settings.link_4 }}" class="c-craft__image-wrap">{% else %}<div class="c-craft__image-wrap">{% endif %}
          {{ section.settings.image_4 | image_url: width: 800 | image_tag: loading: 'lazy' }}
        {% if section.settings.link_4 != blank %}</a>{% else %}</div>{% endif %}
      {% endif %}
      
      {% if section.settings.image_5 != blank %}
        {% if section.settings.link_5 != blank %}<a href="{{ section.settings.link_5 }}" class="c-craft__image-wrap">{% else %}<div class="c-craft__image-wrap">{% endif %}
          {{ section.settings.image_5 | image_url: width: 800 | image_tag: loading: 'lazy' }}
        {% if section.settings.link_5 != blank %}</a>{% else %}</div>{% endif %}
      {% endif %}
      
      {% if section.settings.image_6 != blank %}
        {% if section.settings.link_6 != blank %}<a href="{{ section.settings.link_6 }}" class="c-craft__image-wrap">{% else %}<div class="c-craft__image-wrap">{% endif %}
          {{ section.settings.image_6 | image_url: width: 800 | image_tag: loading: 'lazy' }}
        {% if section.settings.link_6 != blank %}</a>{% else %}</div>{% endif %}
      {% endif %}
    </div>
  {% else %}
    <div class="c-craft__gallery" style="grid-template-columns: 1fr 1fr;">
       <div class="c-craft__image-wrap" style="grid-column: 1 / -1; aspect-ratio: 466 / 262;">
         {{ 'collection-1' | placeholder_svg_tag }}
       </div>
       <div class="c-craft__image-wrap" style="aspect-ratio: 1 / 1;">
         {{ 'collection-2' | placeholder_svg_tag }}
       </div>
       <div class="c-craft__image-wrap" style="aspect-ratio: 1 / 1;">
         {{ 'collection-3' | placeholder_svg_tag }}
       </div>
    </div>
  {% endif %}
</div>
