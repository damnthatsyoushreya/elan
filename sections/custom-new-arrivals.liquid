{% schema %}
{
  "name": "Custom New Arrivals",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "VIEW ALL ->"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Maximum products to show",
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Custom New Arrivals",
      "category": "Collection",
      "blocks": {
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 4,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "name": "t:names.product_card_media",
              "settings": {
                "image_ratio": "adapt",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "price": {
              "type": "price",
              "name": "t:names.product_price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            }
          },
          "block_order": [
            "product-card-gallery",
            "product_title",
            "price"
          ]
        }
      }
    }
  ]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} .cna-section {
    padding: 120px 64px;
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  
  #shopify-section-{{ section.id }} .cna-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 16px;
    border-bottom: 1px solid #000000;
  }
  
  #shopify-section-{{ section.id }} .cna-title {
    font-family: 'Bodoni Moda', serif;
    font-style: normal;
    font-weight: 500;
    font-size: 48px;
    line-height: 56px;
    margin: 0;
    text-transform: uppercase;
  }
  
  #shopify-section-{{ section.id }} .cna-link {
    font-family: 'Inter', sans-serif;
    font-style: normal;
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    color: #000000;
    text-decoration: none;
    letter-spacing: 0.05em;
  }
  
  #shopify-section-{{ section.id }} .cna-blocks {
    width: 100%;
  }

  /* Grid Layout */
  #shopify-section-{{ section.id }} .cna-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    width: 100%;
  }

  /* Carousel Layout using CSS Scroll Snap */
  #shopify-section-{{ section.id }} .cna-carousel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 24px;
    width: 100%;
    scrollbar-width: none; /* Firefox */
  }
  
  #shopify-section-{{ section.id }} .cna-carousel::-webkit-scrollbar {
    display: none; /* Chrome, Safari */
  }

  #shopify-section-{{ section.id }} .cna-carousel .cna-item {
    flex: 0 0 calc(25% - 18px); /* 4 items minus gap */
    scroll-snap-align: start;
  }
  
  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .cna-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    #shopify-section-{{ section.id }} .cna-carousel .cna-item {
      flex: 0 0 calc(33.333% - 16px);
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .cna-section {
      padding: 60px 24px;
      gap: 32px;
    }
    #shopify-section-{{ section.id }} .cna-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .cna-title {
      font-size: 32px;
      line-height: 40px;
    }
    #shopify-section-{{ section.id }} .cna-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .cna-carousel .cna-item {
      flex: 0 0 calc(50% - 8px);
    }
  }
  
  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .cna-grid {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .cna-carousel .cna-item {
      flex: 0 0 85%;
    }
  }
</style>

<div class="cna-section">
  <div class="cna-header">
    <h2 class="cna-title">{{ section.settings.title }}</h2>
    {% if section.settings.link_text != blank %}
      <a href="{{ section.settings.link_url | default: section.settings.collection.url | default: '#' }}" class="cna-link">
        {{ section.settings.link_text }}
      </a>
    {% endif %}
  </div>

  <div class="cna-blocks">
    {% content_for 'blocks' %}
  </div>

  <div class="{% if section.settings.layout == 'carousel' %}cna-carousel{% else %}cna-grid{% endif %}">
    {% assign max_products = section.settings.max_products %}
    {% if section.settings.collection != blank %}
      {% for product in section.settings.collection.products limit: max_products %}
        <div class="cna-item">
          {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..max_products) %}
        <div class="cna-item">
          {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>
